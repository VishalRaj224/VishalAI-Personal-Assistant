rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(docId) {
      return docId is string && docId.size() > 0 && docId.size() <= 128 && docId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/connection {
      allow read: if isSignedIn();
    }

    // Navigation tab labels configuration
    match /tabLabels/{labelId} {
      allow read, write: if isValidId(labelId);
    }

    // User collection and private subcollections
    match /users/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId);

      match /settings/{settingId} {
        allow read, write: if isValidId(userId) && isValidId(settingId) && isOwner(userId);
      }

      match /devices/{deviceId} {
        allow read, write: if isValidId(userId) && isValidId(deviceId) && isOwner(userId);
      }

      match /activityLogs/{logId} {
        allow read, write: if isValidId(userId) && isValidId(logId) && isOwner(userId);
      }
      match /conversations/{conversationId} {
        allow read, write: if isValidId(userId) && isValidId(conversationId) && isOwner(userId);
      }
      match /conversations/{conversationId}/messages/{messageId} {
        allow read, write: if isValidId(userId) && isValidId(conversationId) && isValidId(messageId) && isOwner(userId);
      }

      match /mediaCreations/{mediaId} {
        allow read, write: if isValidId(userId) && isValidId(mediaId) && isOwner(userId);
      }
    }
  }
}
